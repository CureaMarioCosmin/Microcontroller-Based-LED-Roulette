 138:Core/Src/main.c **** void shiftOut(uint8_t data) {
 139:Core/Src/main.c ****   for (int i = 7; i >= 0; i--) {
 140:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOA, GPIO_PIN_2, GPIO_PIN_RESET); 
 141:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOA, GPIO_PIN_1, (data & (1 << i)) ? GPIO_PIN_SET : GPIO_PIN_RESET); 
 142:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOA, GPIO_PIN_2, GPIO_PIN_SET);   
 143:Core/Src/main.c ****   }
 144:Core/Src/main.c **** }
 145:Core/Src/main.c **** 
 146:Core/Src/main.c **** void displayLED(uint8_t index) {
 147:Core/Src/main.c ****   uint8_t data[3] = {0};
ARM GAS  C:\Users\CUREAM~1\AppData\Local\Temp\ccw5GmA9.s 			page 4


 148:Core/Src/main.c **** 
 149:Core/Src/main.c ****   if (index < 24) {
 150:Core/Src/main.c ****       data[index / 8] = 1 << (index % 8);
 151:Core/Src/main.c ****   }
 152:Core/Src/main.c **** 
 153:Core/Src/main.c ****   HAL_GPIO_WritePin(GPIOA, GPIO_PIN_3, GPIO_PIN_RESET); 
 154:Core/Src/main.c ****   shiftOut(data[2]); 
 155:Core/Src/main.c ****   shiftOut(data[1]); 
 156:Core/Src/main.c ****   shiftOut(data[0]); 
 157:Core/Src/main.c ****   HAL_GPIO_WritePin(GPIOA, GPIO_PIN_3, GPIO_PIN_SET);   
 158:Core/Src/main.c **** }
