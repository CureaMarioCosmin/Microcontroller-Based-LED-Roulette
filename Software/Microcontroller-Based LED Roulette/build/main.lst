 109:Core/Src/main.c **** /* Timer2 Interrupt Service Routine: Blinks LEDs */
 110:Core/Src/main.c **** void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim2)
 111:Core/Src/main.c **** {
 112:Core/Src/main.c ****   if(ticks++ == 100)    // 100 timer2 ticks = 1 second 
 113:Core/Src/main.c ****     ticks=0;   // reset 
 114:Core/Src/main.c ****   switch (ticks) {
 115:Core/Src/main.c ****     case 10: 
 116:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, 1); // Red LED
 117:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1, 0);
 118:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8, 0);
 119:Core/Src/main.c ****       break; 
 120:Core/Src/main.c ****     case 25:
 121:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, 0);
 122:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1, 1); // Green
 123:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8, 0);
 124:Core/Src/main.c ****       break; 
 125:Core/Src/main.c ****     case 40:
 126:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, 0);
 127:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1, 0); 
 128:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8, 1); // Blue
 129:Core/Src/main.c ****       break; 
 130:Core/Src/main.c ****     case 55:
 131:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, 0); // all OFF
 132:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1, 0); 
 133:Core/Src/main.c ****       HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8, 0); 
 134:Core/Src/main.c ****       break;
 135:Core/Src/main.c ****   }  // case   
 136:Core/Src/main.c **** }
