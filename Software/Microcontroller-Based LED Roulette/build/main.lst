 288:Core/Src/main.c ****           if (HAL_TIM_Base_Init(&htim2) != HAL_OK) Error_Handler();  // reinitialize timer
 289:Core/Src/main.c ****           User_B_Pressed = 0; // reset flag because it was processed
 290:Core/Src/main.c ****           SM_State = SM_SLOW_BLINK;
 291:Core/Src/main.c ****         }
 292:Core/Src/main.c ****         break;
 293:Core/Src/main.c **** 
 294:Core/Src/main.c ****       case SM_SLOW_BLINK:
