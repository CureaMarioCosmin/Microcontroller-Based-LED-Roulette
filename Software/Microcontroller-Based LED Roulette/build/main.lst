 296:Core/Src/main.c ****           htim2.Init.Period = 100;  // timer counter period original value
 297:Core/Src/main.c ****           if (HAL_TIM_Base_Init(&htim2) != HAL_OK) Error_Handler(); // reinitialize timer
 298:Core/Src/main.c ****           User_B_Pressed = 0;
 299:Core/Src/main.c ****           SM_State = SM_FAST_BLINK;
 300:Core/Src/main.c ****         }
 301:Core/Src/main.c ****         break;
 302:Core/Src/main.c **** 
 303:Core/Src/main.c ****       default:  // this shouldn't happen
 304:Core/Src/main.c ****         SM_State = SM_START;        
 305:Core/Src/main.c ****     } // switch
 306:Core/Src/main.c **** 
 307:Core/Src/main.c ****     if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_6) == GPIO_PIN_RESET) {
 308:Core/Src/main.c ****       HAL_Delay(50); 
 309:Core/Src/main.c ****       if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_6) == GPIO_PIN_RESET) {
 310:Core/Src/main.c ****           while(HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_6) == GPIO_PIN_RESET); 
 311:Core/Src/main.c ****           printf("Va rugam alegeti o pozitie pe care doriti sa pariati!\n\r");
 312:Core/Src/main.c ****           uint8_t bet = selectBet();
 313:Core/Src/main.c ****           rouletteGame(bet);
