 176:Core/Src/main.c **** void rouletteGame(uint8_t bet) {
 177:Core/Src/main.c ****     const uint8_t totalLEDs = 24;
 178:Core/Src/main.c **** 
 179:Core/Src/main.c ****     
 180:Core/Src/main.c ****     static uint8_t seeded = 0;
 181:Core/Src/main.c ****     if (!seeded) {
 182:Core/Src/main.c ****         srand(HAL_GetTick());  
 183:Core/Src/main.c ****         seeded = 1;
 184:Core/Src/main.c ****     }
 185:Core/Src/main.c **** 
 186:Core/Src/main.c ****     uint8_t current = 0;
 187:Core/Src/main.c ****     int delayTime = 50;
 188:Core/Src/main.c **** 
 189:Core/Src/main.c ****     int totalSteps = 60 + rand() % 41;
 190:Core/Src/main.c **** 
 191:Core/Src/main.c ****     for (int i = 0; i < totalSteps; i++) {
 192:Core/Src/main.c ****         displayLED(current);
 193:Core/Src/main.c ****         HAL_Delay(delayTime);
 194:Core/Src/main.c **** 
 195:Core/Src/main.c ****         current = (current + 1) % totalLEDs;
 196:Core/Src/main.c **** 
 197:Core/Src/main.c ****         if (i > totalSteps - 20) delayTime += 5;
 198:Core/Src/main.c ****     }
 199:Core/Src/main.c **** 
 200:Core/Src/main.c ****     displayLED(current);
 201:Core/Src/main.c ****     HAL_Delay(1000);
 202:Core/Src/main.c **** 
 203:Core/Src/main.c ****     if (current == bet) {
 204:Core/Src/main.c ****         for (int i = 0; i < 5; i++) {
ARM GAS  C:\Users\CUREAM~1\AppData\Local\Temp\ccw5GmA9.s 			page 5


 205:Core/Src/main.c ****             displayLED(current);
 206:Core/Src/main.c ****             HAL_Delay(300);
 207:Core/Src/main.c ****             displayLED(255); 
 208:Core/Src/main.c ****             HAL_Delay(300);
 209:Core/Src/main.c ****             printf("Ai castigat!\n\r");
 210:Core/Src/main.c ****         }
 211:Core/Src/main.c ****     } else {
 212:Core/Src/main.c ****         HAL_Delay(2000);
 213:Core/Src/main.c ****         printf("Ai pierdut!\n\r");
 214:Core/Src/main.c ****     }
 215:Core/Src/main.c **** }
