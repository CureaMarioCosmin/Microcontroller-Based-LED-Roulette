 160:Core/Src/main.c **** uint8_t selectBet() {
 161:Core/Src/main.c ****   
 162:Core/Src/main.c ****   uint8_t selection = 0;
 163:Core/Src/main.c **** 
 164:Core/Src/main.c ****   while (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_5) == GPIO_PIN_SET) { 
 165:Core/Src/main.c ****       if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_4) == GPIO_PIN_RESET) { 
 166:Core/Src/main.c ****           selection = (selection + 1) % 24;
 167:Core/Src/main.c ****           displayLED(selection);
 168:Core/Src/main.c ****           HAL_Delay(200); 
 169:Core/Src/main.c ****       }
 170:Core/Src/main.c ****   }
 171:Core/Src/main.c **** 
 172:Core/Src/main.c ****   HAL_Delay(500); 
 173:Core/Src/main.c ****   return selection;
 174:Core/Src/main.c **** }
